{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:product-template-converter:release-matrix-evidence:v3",
  "title": "ReleaseMatrixEvidenceV3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest", "cases"],
  "properties": {
    "schema_version": {"const": "release-matrix-evidence-v3"},
    "manifest": {"$ref": "#/$defs/artifactRef"},
    "cases": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "format"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "format": {"enum": ["DOC", "DOCX", "PPT", "PPTX", "PDF"]}
      }
    },
    "templatePack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "template_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "template_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_decision", "review_receipt", "content_plan", "render_plan",
        "template_program", "output", "pipeline_report"
      ],
      "properties": {
        "content_decision": {"$ref": "#/$defs/artifactRef"},
        "review_receipt": {"$ref": "#/$defs/artifactRef"},
        "content_plan": {"$ref": "#/$defs/artifactRef"},
        "render_plan": {"$ref": "#/$defs/artifactRef"},
        "template_program": {"$ref": "#/$defs/artifactRef"},
        "output": {"$ref": "#/$defs/artifactRef"},
        "pipeline_report": {"$ref": "#/$defs/artifactRef"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "source", "template_pack", "delivery_target", "artifacts", "case_sha256"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/sourceRef"},
        "template_pack": {"$ref": "#/$defs/templatePack"},
        "delivery_target": {"enum": ["desktop", "mobile"]},
        "artifacts": {"$ref": "#/$defs/artifacts"},
        "case_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
