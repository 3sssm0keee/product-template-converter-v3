{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:product-template-converter:image-sanitization-review-receipt:v3",
  "title": "ImageSanitizationReviewReceiptV3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "reviewer_id", "reviewer_role", "reviewed_at", "action", "comment", "selected_images", "scope", "binding"],
  "properties": {
    "schema_version": {"const": "image-sanitization-review-receipt-v3"},
    "review_id": {"type": "string", "pattern": "^IMAGE-REVIEW-[A-F0-9]{64}$"},
    "reviewer_id": {"type": "string", "minLength": 1, "pattern": "[^\\s]"},
    "reviewer_role": {"type": "string", "minLength": 1, "pattern": "[^\\s]"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "action": {"enum": ["APPROVE", "REJECT", "REQUEST_REVISION", "FACT_PENDING"]},
    "comment": {"type": "string", "minLength": 1, "pattern": "[^\\s]"},
    "selected_images": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["region_id", "image_role", "label"],
        "properties": {
          "region_id": {"type": "string", "minLength": 1},
          "image_role": {"enum": ["source_preview", "candidate", "diff"]},
          "label": {"enum": ["源图", "脱敏候选", "差异图"]}
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "regions"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "regions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "binding": {"$ref": "#/$defs/binding"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script_sha256", "receipt_schema_sha256", "request_sha256", "source_sha256", "source_preview_sha256", "candidate_sha256", "diff_sha256", "review_ui_version"],
      "properties": {
        "script_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_schema_sha256": {"$ref": "#/$defs/sha256"},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "source_preview_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_sha256": {"$ref": "#/$defs/sha256"},
        "diff_sha256": {"$ref": "#/$defs/sha256"},
        "review_ui_version": {"const": "image-sanitization-review-1.6.0"},
        "hidden_reviewer_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
