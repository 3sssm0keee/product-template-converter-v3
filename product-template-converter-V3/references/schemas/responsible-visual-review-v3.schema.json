{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:product-template-converter:responsible-visual-review:v3",
  "title": "ResponsibleEngineerVisualReviewV3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "stage", "reviewer_id", "reviewer_role",
    "reviewed_at", "manifest_sha256", "matrix_sha256", "cases", "coverage",
    "release_decision"
  ],
  "properties": {
    "schema_version": {"const": "responsible-visual-review-v3"},
    "status": {"enum": ["PASS", "FAIL"]},
    "stage": {"const": "responsible_engineer_visual_review"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "reviewer_role": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "minLength": 1},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "matrix_sha256": {"$ref": "#/$defs/sha256"},
    "cases": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/case"}
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_pages_reviewed", "output_pages_expected", "complete"],
      "properties": {
        "output_pages_reviewed": {"type": "integer", "minimum": 0},
        "output_pages_expected": {"type": "integer", "minimum": 1},
        "complete": {"type": "boolean"}
      }
    },
    "release_decision": {"enum": ["PROCEED_TO_INDEPENDENT_BLIND_VALIDATION", "RELEASE_HOLD"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "pages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "pipeline_report_sha256", "wps_pages_reviewed", "word_pages_reviewed",
        "expected_pages_per_engine", "findings", "decision", "notes"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "pipeline_report_sha256": {"$ref": "#/$defs/sha256"},
        "wps_pages_reviewed": {"$ref": "#/$defs/pages"},
        "word_pages_reviewed": {"$ref": "#/$defs/pages"},
        "expected_pages_per_engine": {"type": "integer", "minimum": 1},
        "findings": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "decision": {"enum": ["PASS", "FAIL"]},
        "notes": {"type": "string"}
      }
    }
  }
}
