{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:product-template-converter:template-diff-report:v3",
  "title": "TemplateDiffReportV3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "generated_at",
    "status",
    "compiler",
    "source",
    "candidate",
    "program_sha256",
    "comparisons",
    "findings",
    "diff_report_sha256"
  ],
  "properties": {
    "schema_version": {"const": "template-diff-report-v3"},
    "artifact_type": {"const": "TemplateDiffReportV3"},
    "generated_at": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "FAIL"]},
    "compiler": {"$ref": "#/$defs/identity"},
    "source": {"$ref": "#/$defs/artifact"},
    "candidate": {"$ref": "#/$defs/artifact"},
    "program_sha256": {"$ref": "#/$defs/sha256"},
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "expected", "actual"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL"]},
          "expected": {},
          "actual": {}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "comparison"],
        "properties": {
          "code": {"const": "TEMPLATE_RECONSTRUCTION_DIFFERENCE"},
          "comparison": {"type": "string", "minLength": 1}
        }
      }
    },
    "render_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "engines", "evidence"],
      "properties": {
        "status": {"const": "PASS"},
        "engines": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["engine", "original_page_count", "candidate_page_count", "max_mean_absolute_difference"],
            "properties": {
              "engine": {"enum": ["wps", "word"]},
              "original_page_count": {"type": "integer", "minimum": 1},
              "candidate_page_count": {"type": "integer", "minimum": 1},
              "max_mean_absolute_difference": {"type": "number", "minimum": 0}
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "path", "sha256"],
            "properties": {
              "kind": {"enum": ["original_export_report", "candidate_export_report", "wps_visual_diff", "word_visual_diff"]},
              "path": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "diff_report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "ir_sha256"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "ir_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
