{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:product-template-converter:first-template-validation-run-spec-draft:v3",
  "title": "FirstTemplateValidationRunSpecDraftV3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest", "cases"],
  "properties": {
    "schema_version": {"const": "first-template-validation-run-spec-draft-v3"},
    "manifest": {"$ref": "#/$defs/artifactRef"},
    "cases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "nullableArtifactRef": {
      "oneOf": [
        {"$ref": "#/$defs/artifactRef"},
        {"type": "null"}
      ]
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "format"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "format": {"enum": ["DOC", "DOCX", "PPT", "PPTX", "PDF"]}
      }
    },
    "templatePack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "template_sha256"],
      "properties": {
        "id": {"const": "zxty-fixed-v1"},
        "version": {"const": "1.0.0"},
        "template_path": {"type": "string", "minLength": 1},
        "template_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "source", "template_pack", "content_decision", "review_queue", "review_receipt", "delivery_target"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/sourceRef"},
        "template_pack": {"$ref": "#/$defs/templatePack"},
        "content_decision": {"$ref": "#/$defs/artifactRef"},
        "review_queue": {"$ref": "#/$defs/nullableArtifactRef"},
        "review_receipt": {"$ref": "#/$defs/nullableArtifactRef"},
        "delivery_target": {"enum": ["desktop", "mobile"]}
      }
    }
  }
}
