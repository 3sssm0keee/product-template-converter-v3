{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:product-template-converter:content-plan:v3",
  "title": "ContentPlanV3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "generator", "upstream", "template_pack",
    "normalized_source", "product", "manufacturer_terms", "identity_review",
    "review_approval", "items", "review_items", "evidence_bindings", "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "content-plan-v3"},
    "generator": {"$ref": "#/$defs/generator"},
    "upstream": {"$ref": "#/$defs/upstream"},
    "template_pack": {"$ref": "#/$defs/templatePack"},
    "normalized_source": {"$ref": "#/$defs/normalizedSource"},
    "product": {"$ref": "#/$defs/product"},
    "manufacturer_terms": {"$ref": "#/$defs/stringArray"},
    "identity_review": {"$ref": "#/$defs/identityReview"},
    "review_approval": {"$ref": "#/$defs/reviewApproval"},
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/planItem"}},
    "review_items": {"type": "array", "items": {"$ref": "#/$defs/planItem"}},
    "evidence_bindings": {"type": "array", "items": {"$ref": "#/$defs/evidenceBinding"}},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "content-plan-builder"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema_version"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"type": "string", "minLength": 1}
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_document", "content_decision", "policy_sha256"],
      "properties": {
        "source_document": {"$ref": "#/$defs/artifactRef"},
        "content_decision": {"$ref": "#/$defs/artifactRef"},
        "review_receipt": {"$ref": "#/$defs/artifactRef"},
        "policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "templatePack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "normalizedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "format"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "format": {"enum": ["docx", "pptx", "pdf", "DOCX", "PPTX", "PDF"]}
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "full_name"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "full_name": {"type": "string", "minLength": 1}
      }
    },
    "identityReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "manufacturer_terms", "evidence_ids", "notes"],
      "properties": {
        "status": {"enum": ["VERIFIED", "NO_SOURCE_IDENTITY_FOUND", "REVIEW_REQUIRED"]},
        "manufacturer_terms": {"$ref": "#/$defs/stringArray"},
        "evidence_ids": {"$ref": "#/$defs/stringArray"},
        "notes": {"type": "string"}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha256", "template_sha256", "template_ir_sha256", "template_dsl_sha256",
        "compiler_sha256", "candidate_output_sha256", "diff_report_sha256"
      ],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "template_sha256": {"$ref": "#/$defs/sha256"},
        "template_ir_sha256": {"$ref": "#/$defs/sha256"},
        "template_dsl_sha256": {"$ref": "#/$defs/sha256"},
        "compiler_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_output_sha256": {"$ref": "#/$defs/sha256"},
        "diff_report_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "reviewApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_id", "reviewer", "reviewed_at", "overall_action", "scope", "binding"],
      "properties": {
        "review_id": {"type": "string", "minLength": 1},
        "reviewer": {"$ref": "#/$defs/reviewer"},
        "reviewed_at": {"type": "string", "minLength": 1},
        "overall_action": {"const": "APPROVED"},
        "scope": {"enum": ["ENTIRE_QUEUE", "SELECTED_ITEMS"]},
        "binding": {"$ref": "#/$defs/binding"}
      }
    },
    "contextValue": {"type": ["string", "integer", "number", "boolean"]},
    "payload": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["type", "text"],
          "properties": {"type": {"const": "text"}, "text": {"type": "string"}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "rows"],
          "properties": {
            "type": {"const": "table"},
            "rows": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "name", "sha256", "visual_sha256", "bytes", "media_kind"],
          "properties": {
            "type": {"const": "asset"}, "name": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"},
            "visual_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
            "bytes": {"type": "integer", "minimum": 0}, "media_kind": {"enum": ["image", "media"]}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "source_part", "relationship_id", "relationship_type", "target", "target_mode"],
          "properties": {
            "type": {"const": "relationship"}, "source_part": {"type": "string"},
            "relationship_id": {"type": "string"}, "relationship_type": {"type": "string"},
            "target": {"type": "string"}, "target_mode": {"type": "string"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "text", "name", "title", "description"],
          "properties": {
            "type": {"const": "description"}, "text": {"type": "string"}, "name": {"type": "string"},
            "title": {"type": "string"}, "description": {"type": "string"}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "value"],
          "properties": {"type": {"const": "generic"}, "value": {"type": "object"}}
        }
      ]
    },
    "typedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "location", "payload", "context", "attributes"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "payload": {"$ref": "#/$defs/payload"},
        "context": {"type": "object", "additionalProperties": {"$ref": "#/$defs/contextValue"}},
        "attributes": {"type": "object"}
      }
    },
    "reviewedBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "target_slot", "target_order", "evidence_ids"],
      "properties": {
        "text": {"type": "string", "minLength": 1}, "target_slot": {"type": "string", "minLength": 1},
        "target_order": {"type": "integer", "minimum": 0}, "evidence_ids": {"$ref": "#/$defs/stringArray"}
      }
    },
    "replacementRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "review_note"],
      "properties": {
        "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"},
        "review_note": {"type": "string", "minLength": 1}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "action", "confidence", "evidence_ids", "rationale"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "action": {"enum": ["preserve_exact", "preserve_image", "preserve_sanitized_image", "redact_identity", "reviewed_text", "remove_identity", "remove_template_background", "exclude_from_output", "human_review"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_ids": {"$ref": "#/$defs/stringArray"}, "rationale": {"type": "string", "minLength": 1},
        "target_slot": {"type": "string", "minLength": 1}, "target_order": {"type": "integer", "minimum": 0},
        "reviewed_text": {"type": "string", "minLength": 1},
        "reviewed_blocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reviewedBlock"}},
        "redactions": {"$ref": "#/$defs/stringArray"}, "replacement_ref": {"$ref": "#/$defs/replacementRef"}
      }
    },
    "planItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source", "decision", "execution_order"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/typedItem"},
        "decision": {"$ref": "#/$defs/decision"},
        "execution_order": {"type": "integer", "minimum": 1}
      }
    },
    "evidenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "source_id", "kind", "path", "sha256", "page_or_position"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1}, "source_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}, "page_or_position": {"type": "string"}
      }
    }
  }
}
