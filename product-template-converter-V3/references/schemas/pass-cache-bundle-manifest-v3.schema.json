{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:product-template-converter:pass-cache-bundle-manifest:v3",
  "title": "PassArtifactBundleManifestV3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "key", "created_at", "inputs_sha256", "facts", "final_artifact", "members"],
  "properties": {
    "schema_version": {"const": "pass-artifact-bundle-manifest-v3"},
    "stage": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
    "key": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "minLength": 1},
    "inputs_sha256": {"$ref": "#/$defs/sha256"},
    "facts": {
      "type": "object",
      "required": ["status", "deliverable"],
      "properties": {
        "status": {"const": "PASS"},
        "deliverable": {"const": true}
      }
    },
    "final_artifact": {"type": "string", "minLength": 1},
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/member"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "role"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0},
        "role": {"enum": ["final_artifact", "validation_evidence"]}
      }
    }
  }
}
