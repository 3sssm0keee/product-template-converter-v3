{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:product-template-converter:independent-blind-visual-review:v3",
  "title": "IndependentBlindVisualReviewV3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "stage", "reviewer_id", "reviewer_role",
    "reviewed_at", "manifest_sha256", "matrix_sha256", "cases",
    "total_pages_expected", "total_pages_reviewed", "complete", "findings", "decision"
  ],
  "properties": {
    "schema_version": {"const": "independent-blind-visual-review-v3"},
    "status": {"enum": ["PASS", "FAIL"]},
    "stage": {"const": "independent_blind_visual_review"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "reviewer_role": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "minLength": 1},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "matrix_sha256": {"$ref": "#/$defs/sha256"},
    "cases": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/case"}
    },
    "total_pages_expected": {"type": "integer", "minimum": 1},
    "total_pages_reviewed": {"type": "integer", "minimum": 0},
    "complete": {"type": "boolean"},
    "findings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "decision": {"enum": ["PASS", "FAIL"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "pages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "wps_pages_reviewed", "word_pages_reviewed", "pages_expected",
        "pages_reviewed", "complete", "source_brand_residual_found",
        "substantive_engine_difference_found", "findings", "decision"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "wps_pages_reviewed": {"$ref": "#/$defs/pages"},
        "word_pages_reviewed": {"$ref": "#/$defs/pages"},
        "pages_expected": {"type": "integer", "minimum": 2},
        "pages_reviewed": {"type": "integer", "minimum": 0},
        "complete": {"type": "boolean"},
        "source_brand_residual_found": {"type": "boolean"},
        "substantive_engine_difference_found": {"type": "boolean"},
        "findings": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "decision": {"enum": ["PASS", "FAIL"]}
      }
    }
  }
}
