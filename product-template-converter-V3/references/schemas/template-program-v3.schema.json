{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zxty:template-program-v3",
  "title": "TemplateProgramV3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "template_pack",
    "template_sha256",
    "template_ir_sha256",
    "compiler",
    "adapter",
    "operations",
    "program_sha256"
  ],
  "properties": {
    "schema_version": {"const": "template-program-v3"},
    "artifact_type": {"const": "TemplateProgramV3"},
    "template_pack": {"$ref": "#/$defs/identity"},
    "template_sha256": {"$ref": "#/$defs/sha256"},
    "template_ir_sha256": {"$ref": "#/$defs/sha256"},
    "compiler": {"$ref": "#/$defs/identity"},
    "adapter": {"type": "string", "minLength": 1},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/operation"}
    },
    "program_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "operation": {
      "oneOf": [
        {"$ref": "#/$defs/retain_part"},
        {"$ref": "#/$defs/bind_slot"},
        {"$ref": "#/$defs/bind_asset_role"},
        {"$ref": "#/$defs/apply_style_ref"},
        {"$ref": "#/$defs/repeat_block"},
        {"$ref": "#/$defs/insert_text"},
        {"$ref": "#/$defs/insert_image"},
        {"$ref": "#/$defs/insert_table"},
        {"$ref": "#/$defs/bind_header_footer"},
        {"$ref": "#/$defs/section_break"},
        {"$ref": "#/$defs/page_break"},
        {"$ref": "#/$defs/validate_invariant"}
      ]
    },
    "retain_part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "part", "required"],
      "properties": {
        "op": {"const": "retain_part"},
        "part": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"}
      }
    },
    "bind_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "slot_id", "source", "required"],
      "properties": {
        "op": {"const": "bind_slot"},
        "slot_id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"}
      }
    },
    "bind_asset_role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "role", "part", "required"],
      "properties": {
        "op": {"const": "bind_asset_role"},
        "role": {"type": "string", "minLength": 1},
        "part": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"}
      }
    },
    "apply_style_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "slot_id", "style_id"],
      "properties": {
        "op": {"const": "apply_style_ref"},
        "slot_id": {"type": "string", "minLength": 1},
        "style_id": {"type": "string", "minLength": 1}
      }
    },
    "repeat_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "slot_id", "source", "min_items", "max_items"],
      "properties": {
        "op": {"const": "repeat_block"},
        "slot_id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "min_items": {"type": "integer", "minimum": 0},
        "max_items": {"type": "integer", "minimum": 1}
      }
    },
    "insert_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "slot_id", "source"],
      "properties": {
        "op": {"const": "insert_text"},
        "slot_id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "style_id": {"type": "string", "minLength": 1}
      }
    },
    "insert_image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "slot_id", "source", "fit"],
      "properties": {
        "op": {"const": "insert_image"},
        "slot_id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "fit": {"enum": ["contain", "cover", "native"]}
      }
    },
    "insert_table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "slot_id", "source", "geometry_id"],
      "properties": {
        "op": {"const": "insert_table"},
        "slot_id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "geometry_id": {"type": "string", "minLength": 1}
      }
    },
    "bind_header_footer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "section", "kind", "part"],
      "properties": {
        "op": {"const": "bind_header_footer"},
        "section": {"type": "integer", "minimum": 1},
        "kind": {"enum": ["header", "footer", "first_header", "first_footer", "even_header", "even_footer"]},
        "part": {"type": "string", "minLength": 1}
      }
    },
    "section_break": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "type"],
      "properties": {
        "op": {"const": "section_break"},
        "type": {"enum": ["continuous", "newPage", "evenPage", "oddPage"]}
      }
    },
    "page_break": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op"],
      "properties": {"op": {"const": "page_break"}}
    },
    "validate_invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "invariant", "expected"],
      "properties": {
        "op": {"const": "validate_invariant"},
        "invariant": {"type": "string", "minLength": 1},
        "expected": {}
      }
    }
  }
}
